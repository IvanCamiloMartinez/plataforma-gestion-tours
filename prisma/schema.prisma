// ==============================================================================
// PLATAFORMA DE GESTIÓN Y DESARROLLO TURÍSTICO (SaaS B2B)
// Esquema Relacional de Base de Datos - Prisma ORM
// Motor: PostgreSQL con Transacciones ACID y Aislamiento Multi-Tenant Lógico
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------------------------
// ENUMS DE DOMINIO Y REGLAS DE NEGOCIO
// ------------------------------------------------------------------------------

enum PlanType {
  RASTRILLO    // Gratuito: 2 guías, 2 tours, 4 salidas/mes, 4 categorías básicas
  GUIA         // Medio ($79.000 COP/mes): 6 guías, 6 tours, 12 salidas/mes, White-Label
  TOUR_LEADER  // Avanzado ($199.000 COP/mes): Ilimitado, soporte prioritario
}

enum UserRole {
  ADMIN  // Dueño de cuenta, control total financiero, comercial y operativo
  GUIA   // Guía de campo, acceso ciego a finanzas, visor de itinerario y offline
}

enum ProviderCategory {
  TRANSPORTE            // Vans, camperos, chivas, lanchas
  ALIMENTACION          // Restaurantes campesinos, refrigerios, gastronomía local
  SALUD_EMERGENCIAS     // Puestos de salud, socorristas, hospitales locales
  SEGUROS               // Asistencia médica en viaje y pólizas obligatorias
  ACTIVIDAD_EXPERIENCIA // Catas, talleres, cabalgatas, escalada
  HOSPEDAJE             // Glamping, fincas tradicionales, hoteles
  NATURALEZA_ECOTURISMO // Reservas naturales, parques ecológicos
  ARTESANIA_CULTURA     // Talleres artesanales, comunidades indígenas
  FOTOGRAFIA_CONTENIDO  // Registro audiovisual y fotográfico
  PERMISOS_INSTITUCION  // Parques Nacionales Naturales, resguardos, entidades
}

enum TourDifficulty {
  BAJA
  MEDIA
  ALTA
  EXPERTO
}

enum TourStatus {
  BORRADOR
  PUBLICADO
  ARCHIVADO
}

enum CostType {
  FIXED_DEPARTURE  // Costo fijo por salida (ej. honorarios del guía, alquiler de van)
  VARIABLE_PAX     // Costo variable unitario por participante (ej. seguro, catas, entradas)
  VARIABLE_GROUP   // Costo variable grupal por umbral (ej. guía auxiliar cada 8 pax)
}

enum DepartureStatus {
  PROGRAMADA
  EN_CURSO
  COMPLETADA
  REPROGRAMADA
  CANCELADA
}

enum PassengerAttendanceStatus {
  CONFIRMADO
  ASISTIO
  NO_SHOW
  CANCELADO
}

enum PaymentStatus {
  PENDIENTE     // Sin pago registrado
  ANTICIPO      // Habitualmente 50% para reserva de cupo
  PAGADO_TOTAL  // Liquidado al 100%
}

enum DocumentType {
  CC   // Cédula de Ciudadanía
  CE   // Cédula de Extranjería
  PAS  // Pasaporte
  PPT  // Permiso por Protección Temporal (Estatuto Migratorio Colombia)
  TI   // Tarjeta de Identidad
  OTRO
}

// ------------------------------------------------------------------------------
// ENTIDADES PRINCIPALES (12 MODELOS)
// ------------------------------------------------------------------------------

/// Organización / Empresa (Tenant Raíz Multi-Tenant)
model Organization {
  id              String      @id @default(cuid())
  legalName       String      // Razón social o nombre legal
  commercialName  String      // Nombre comercial (ej. Bogotá Nativa)
  rntNumber       String?     // Registro Nacional de Turismo (Ley 2068)
  rntVerified     Boolean     @default(false)
  logoUrl         String?
  phone           String
  email           String      @unique
  address         String?
  city            String      @default("Bogotá")
  country         String      @default("Colombia")
  
  planType        PlanType    @default(RASTRILLO)
  subscriptionEnd DateTime?
  
  // Gestión de Prueba Gratuita (Free Trial de 30 días sin tarjeta)
  trialPlan       PlanType?   // Plan que se está evaluando (GUIA o TOUR_LEADER)
  trialEndsAt     DateTime?   // Fecha y hora exacta de vencimiento del trial
  isTrialActive   Boolean     @default(false)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relaciones
  users               User[]
  providers           Provider[]
  stops               Stop[]
  activities          Activity[]
  interpretiveScripts InterpretiveScript[]
  tours               Tour[]
  departures          Departure[]

  @@map("organizations")
}

/// Usuario del Sistema (Admin u Operativo)
model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  email          String       @unique
  passwordHash   String
  fullName       String
  phone          String
  professionalCard String?    // Tarjeta profesional de guía de turismo
  role           UserRole     @default(GUIA)
  isActive       Boolean      @default(true)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relaciones
  ledDepartures       Departure[] @relation("LeadGuide")
  assistantDepartures Departure[] @relation("AssistantGuide")

  @@index([organizationId])
  @@map("users")
}

/// Proveedor / Aliado Comercial (Cadena de Valor)
model Provider {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  category       ProviderCategory
  commercialName String
  contactPerson  String?
  phone          String
  email          String?
  address        String?
  city           String?
  notesPrivate   String?          @db.Text // Notas logísticas confidenciales

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?        // Trazabilidad inmutable (Soft Delete)

  // Relaciones
  tariffs         Tariff[]
  itineraryBlocks ItineraryBlock[]
  costItems       CostItem[]

  @@index([organizationId, category])
  @@index([deletedAt])
  @@map("providers")
}

/// Tarifario Histórico de Proveedor (Inmutabilidad Financiera)
model Tariff {
  id          String    @id @default(cuid())
  providerId  String
  provider    Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)

  concept     String    // Concepto del servicio (ej. "Cata de chicha en totuma")
  costType    CostType  @default(VARIABLE_PAX)
  amount      Decimal   @db.Decimal(12, 2) // Valores exactos en COP
  currency    String    @default("COP")
  validFrom   DateTime  @default(now())
  validUntil  DateTime?

  createdAt   DateTime  @default(now())

  // Relaciones
  costItems   CostItem[]

  @@index([providerId])
  @@map("tariffs")
}

/// Parada Física o Atractivo (Catálogo Reutilizable)
model Stop {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String       // Ej. "Plaza del Chorro de Quevedo"
  municipality   String       @default("Bogotá D.C.")
  addressDesc    String?      // Dirección o descripción de acceso
  latitude       Float?
  longitude      Float?
  googleMapsUrl  String?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?    // Trazabilidad inmutable (Soft Delete)

  itineraryBlocks ItineraryBlock[]

  @@index([organizationId])
  @@index([deletedAt])
  @@map("stops")
}

/// Tipo de Actividad o Experiencia (Catálogo Reutilizable)
model Activity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title          String       // Ej. "Cata sensorial guiada"
  defaultDurationMin Int      @default(45)
  categoryTag    String?      // Ej. "Gastronomía", "Senderismo", "Patrimonio"

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  itineraryBlocks ItineraryBlock[]

  @@index([organizationId])
  @@map("activities")
}

/// Guión Interpretativo y Storytelling Cultural (Catálogo Reutilizable)
model InterpretiveScript {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title          String       // Ej. "La chicha como fermento sagrado Muisca"
  narrativeText  String       @db.Text // El relato histórico y cultural que narra el guía
  icebreakerPrompt String?    @db.Text // Pregunta detonante para romper el hielo
  curiosities    String?      @db.Text // Datos curiosos y anécdotas

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  itineraryBlocks ItineraryBlock[]

  @@index([organizationId])
  @@map("interpretive_scripts")
}

/// Tour / Producto Turístico (Plantilla Conceptual)
model Tour {
  id                  String         @id @default(cuid())
  organizationId      String
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title               String         // Ej. "Bogotá en 4 Bebidas Tradicionales"
  slug                String         // URL amigable para ficha web pública
  narrativeConcept    String?        @db.Text // Hilo conductor del storytelling
  destination         String         // Ej. "La Candelaria, Bogotá"
  difficulty          TourDifficulty @default(BAJA)
  durationHours       Decimal        @db.Decimal(4, 2) // Ej. 3.50 horas
  minPax              Int            @default(4)
  maxPax              Int            @default(12)
  status              TourStatus     @default(BORRADOR)
  coverImageUrl       String?        // Foto principal de portada / banner del tour

  // Textos para la Ficha Comercial
  commercialSummary   String?        @db.Text
  includedServices    String?        @db.Text // Qué incluye (viñetas)
  notIncludedServices String?        @db.Text // Qué no incluye
  recommendations     String?        @db.Text // Qué llevar, calzado, etc.
  cancellationPolicy  String?        @db.Text

  // Parámetros de Precio Base Sugerido
  targetMarginPercent Decimal?       @db.Decimal(5, 2) // Ej. 35.00%
  suggestedPricePax   Decimal?       @db.Decimal(12, 2)
  referenceTrmUsd     Decimal?       @db.Decimal(10, 2) // TRM informativa opcional para cotizaciones en USD

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?      // Trazabilidad inmutable (Soft Delete)

  // Relaciones
  itineraryBlocks     ItineraryBlock[]
  costItems           CostItem[]
  departures          Departure[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([deletedAt])
  @@map("tours")
}

/// Bloque de Itinerario (Instancia Secuencial del Tour con 3 Capas)
model ItineraryBlock {
  id                   String              @id @default(cuid())
  tourId               String
  tour                 Tour                @relation(fields: [tourId], references: [id], onDelete: Cascade)

  orderIndex           Int                 // 0, 1, 2, 3... (Reordenable por Drag & Drop)
  startTimeEstimated   String?             // Hora calculada (ej. "14:00")
  durationMinutes      Int                 @default(45)
  walkToNextMinutes    Int                 @default(5)

  // Enlaces a Catálogo Reutilizable (Opcionales para máxima flexibilidad)
  stopId               String?
  stop                 Stop?               @relation(fields: [stopId], references: [id], onDelete: SetNull)
  activityId           String?
  activity             Activity?           @relation(fields: [activityId], references: [id], onDelete: SetNull)
  scriptId             String?
  script               InterpretiveScript? @relation(fields: [scriptId], references: [id], onDelete: SetNull)
  providerId           String?
  provider             Provider?           @relation(fields: [providerId], references: [id], onDelete: SetNull)

  // 1. CAPA COMERCIAL (Pública en PDF / Ficha)
  commercialTitle      String              // Ej. "Cata de Chicha Ancestral"
  commercialDesc       String?             @db.Text
  imageUrl             String?             // Foto opcional representativa de la parada/actividad

  // 2. CAPA INTERPRETATIVA ESPECÍFICA (Storytelling del Guía)
  customStorytelling   String?             @db.Text
  icebreakerPrompt     String?             @db.Text

  // 3. CAPA OPERATIVA PRIVADA (Solo Guía y Admin)
  privateLogisticsNotes String?            @db.Text // Ej. "Pagar $32.000 en efectivo a Don Mario"

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([tourId, orderIndex])
  @@map("itinerary_blocks")
}

/// Elemento de Costo del Tour (Calculadora Financiera Desacoplada)
model CostItem {
  id               String       @id @default(cuid())
  tourId           String
  tour             Tour         @relation(fields: [tourId], references: [id], onDelete: Cascade)

  concept          String       // Ej. "Honorarios Guía", "Cata Chicha", "Seguro"
  costType         CostType     @default(VARIABLE_PAX)
  amount           Decimal      @db.Decimal(12, 2) // Monto unitario o fijo en COP
  currency         String       @default("COP")

  providerId       String?
  provider         Provider?    @relation(fields: [providerId], references: [id], onDelete: SetNull)
  tariffSnapshotId String?
  tariffSnapshot   Tariff?      @relation(fields: [tariffSnapshotId], references: [id], onDelete: SetNull)

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([tourId])
  @@map("cost_items")
}

/// Salida Programada en Calendario (Ejecución Concreta)
model Departure {
  id                   String          @id @default(cuid())
  organizationId       String
  organization         Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tourId               String
  tour                 Tour            @relation(fields: [tourId], references: [id], onDelete: Restrict)

  departureDate        DateTime        // Fecha y hora de salida
  returnDate           DateTime?       // Fecha y hora estimada de retorno
  maxCapacity          Int             // Aforo máximo contratado (ej. 12 pax van)
  status               DepartureStatus @default(PROGRAMADA)

  leadGuideId          String
  leadGuide            User            @relation("LeadGuide", fields: [leadGuideId], references: [id], onDelete: Restrict)
  assistantGuideId     String?
  assistantGuide       User?           @relation("AssistantGuide", fields: [assistantGuideId], references: [id], onDelete: SetNull)

  operationalNotes     String?         @db.Text // Notas logísticas del día de salida
  rescheduledFrom      DateTime?       // Fecha original si fue reprogramada por clima/fuerza mayor
  rescheduledReason    String?         // Motivo del cambio (ej. "Alerta clima IDEAM / Cierre PNN")

  // Cierre de Caja y Balance Financiero de la Salida (COMPLETADA)
  actualRevenue        Decimal?        @db.Decimal(12, 2) // Total recaudado real de pasajeros
  actualCosts          Decimal?        @db.Decimal(12, 2) // Total liquidado a aliados en ruta
  netProfit            Decimal?        @db.Decimal(12, 2) // Ganancia neta real en el bolsillo del guía/agencia

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  deletedAt            DateTime?       // Trazabilidad inmutable (Soft Delete)

  // Relaciones
  passengers           Passenger[]

  @@index([organizationId, departureDate])
  @@index([tourId])
  @@index([deletedAt])
  @@map("departures")
}

/// Pasajero / Manifiesto de Viaje (Cumplimiento Legal Habeas Data y Póliza de Asistencia Médica)
model Passenger {
  id                     String                    @id @default(cuid())
  departureId            String
  departure              Departure                 @relation(fields: [departureId], references: [id], onDelete: Cascade)

  // Identificación oficial (Estándar Colasistencia / Assist Card)
  docType                DocumentType              @default(CC)
  docNumber              String
  fullName               String
  birthDate              DateTime?                 // Fecha de nacimiento obligatoria para emisión de póliza
  phone                  String?

  // Contacto de emergencia obligatorio (tercero no viajero)
  emergencyContactName   String                    // Familiar o contacto externo
  emergencyContactPhone  String                    // Celular de emergencia con indicativo

  // Alertas médicas y requerimientos dietéticos
  medicalAlerts          String?                   @db.Text // Alergias severas, afecciones cardíacas, asma, medicación vital
  dietaryRestrictions    String?                   // Vegetariano, Vegano, Celíaco, intolerancia
  healthInsuranceEps     String?                   // EPS o seguro médico base

  attendanceStatus       PassengerAttendanceStatus @default(CONFIRMADO)

  // Control de Anticipos y Pagos (Regla 50% / Saldo en Campo)
  paymentStatus          PaymentStatus             @default(PENDIENTE)
  paidAmount             Decimal?                  @db.Decimal(12, 2) // Anticipo registrado (ej. 50%)
  pendingBalance         Decimal?                  @db.Decimal(12, 2) // Saldo pendiente a cobrar en efectivo

  // Cumplimiento Legal Habeas Data (Ley Estatutaria 1581 de 2012)
  habeasDataConsent      Boolean                   @default(true)
  habeasDataAcceptedAt   DateTime                  @default(now())
  anonymizedAt           DateTime?                 // Fecha de borrado seguro (Derecho al Olvido)

  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@index([departureId])
  @@index([docNumber])
  @@map("passengers")
}
